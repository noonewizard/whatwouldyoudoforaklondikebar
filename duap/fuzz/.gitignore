# Corpora are regenerated by running the fuzzer and grow without bound
# (23 MB after 15 minutes). They are a cache, not a source artefact.
corpus/
# Crashes are committed as regression *tests* in the crate they belong to,
# with the input written out in the test, not as opaque blobs here. A blob
# nobody can read is not evidence.
artifacts/
target/
Cargo.lock
