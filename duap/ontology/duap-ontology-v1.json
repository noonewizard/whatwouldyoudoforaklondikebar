      "description": "One query execution that touched the subject's data.",
      "additive": true
    },
    {
      "code": "inference",
      "name": "inference",
      "description": "One inference produced using the subject's data.",
      "additive": true
    },
    {
      "code": "impression",
      "name": "impression",
      "description": "One advertising impression informed by the data.",
      "additive": true
    },
    {
      "code": "token",
      "name": "token",
      "description": "One training token attributable to the subject's data.",
      "additive": true
    },
    {
      "code": "comparison",
      "name": "comparison",
      "description": "One preference comparison.",
      "additive": true
    },
    {
      "code": "episode",
      "name": "episode",
      "description": "One reinforcement-learning episode.",
      "additive": true
    },
    {
      "code": "retrieval",
      "name": "retrieval",
      "description": "One retrieval of the record into a context window.",
      "additive": true
    },
    {
      "code": "gradient_step",
      "name": "gradient-step",
      "description": "One optimiser step in which the record appeared in the batch.",
      "additive": true
    },
    {
      "code": "share",
