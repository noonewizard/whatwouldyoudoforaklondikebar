  "units": [
    {
      "code": "record",
      "name": "record",
      "description": "One data record or field group about one subject.",
      "additive": true
    },
    {
      "code": "byte",
      "name": "byte",
      "description": "Octets of subject data at rest or in transit.",
      "additive": true
    },
    {
